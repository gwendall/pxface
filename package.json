{
  "name": "pxface-repository",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "dev": "npm run package:build && next dev",
    "build": "npm run package:build && next build",
    "start": "next start",
    "lint": "eslint",
    "package:build": "npm run build --workspace pxface",
    "package:verify": "npm run package:build && node scripts/verify-package.mjs && npm pack --workspace pxface --dry-run",
    "font:build": "python3 scripts/build-fonts.py",
    "font:verify": "python3 scripts/verify-font-packages.py",
    "fixtures:update": "tsx scripts/update-golden.ts",
    "test": "npm run package:build && vitest run",
    "test:watch": "npm run package:build && vitest"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "mediabunny": "^1.55.1",
    "modern-gif": "^2.1.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsup": "^8.5.0",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
